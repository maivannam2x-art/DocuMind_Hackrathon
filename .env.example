NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the newer publishable key when available; legacy anon keys are supported too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Defaults to mock for deterministic local testing. Set to gemini when ready.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Concurrent independent pages/chunks per request (1–4); default 3.
LLM_CONCURRENCY=3
# Optional ordered allowlist, intersected with models.list before generation.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-3.1-pro-preview

GUEST_SESSION_TTL_HOURS=24
CRON_SECRET=
MAX_UPLOAD_MB=20
MAX_VISION_MB=8
MAX_PDF_PAGES=200
MAX_EXTRACTED_MEDIA_MB=64
MAX_ANALYSIS_CHARS=500000
MAX_CHUNK_CHARS=12000
MIN_MAJOR_SECTION_CHARS=2500
CHUNK_OVERLAP_CHARS=500

# Document content is redacted in LLM logs by default. Enable only for diagnostics.
LLM_LOG_CONTENT=false
LLM_LOG_RETENTION_DAYS=30
